#!/bin/bash
# Publish finished PDFs from the cups-pdf staging directory into OUTPUT_DIR.
#
# As soon as cups-pdf finishes a file, it is "claimed": moved into its own directory in staging
# under its final output name. That fixes its title while cupsd still knows the job, and frees
# cups-pdf's name ("<title>-job_<id>.pdf") so a later job reusing the id can't overwrite it.
# Claimed files are copied into OUTPUT_DIR under a unique hidden temporary name with the
# configured owner and mode, then renamed into place. rename(2) is atomic within one directory,
# so a watcher (e.g. paperless-ngx) only ever sees complete files. Files that cannot be
# published (e.g. read-only or full volume) stay claimed in staging and are retried.
set -uo pipefail
shopt -s nullglob dotglob

# shellcheck source=/dev/null
. /run/vprint/env

readonly POLL_SECONDS=${VPRINT_MOVER_POLL_SECONDS:-1}
# Leftover temporary files older than this are from a crashed publisher. A live publish holds
# its temporary file for milliseconds, so this never touches another container's in-flight copy.
readonly PARTIAL_MAX_AGE_MIN=10
# A staged PDF with no .done/.failed marker that hasn't changed for this long was cut off
# mid-conversion (e.g. the container was killed) and will never be finished.
readonly ORPHAN_MAX_AGE_MIN=60
mode=$(printf '%04o' $((0666 & ~8#${UMASK})))
# Health signals for vprint-healthcheck: STUCK exists while some file can't be claimed or
# published and holds the reason (its mtime is when that started); HEARTBEAT is touched as
# work progresses.
readonly STUCK=/run/vprint/mover.stuck HEARTBEAT=/run/vprint/mover.heartbeat
# Files that failed this pass / last pass (the latter so each problem is logged once).
declare -A failing=() warned=()
stuck_reason=
ownership_warned=

log() { printf 'vprint-mover: %s\n' "$*" >&2; }

# Note a file that can't make progress; log the reason only when it first starts failing.
blocked() {
  failing[$1]=1
  stuck_reason=$2
  [[ -n ${warned[$1]:-} ]] || log "$2"
}

# lpstat -r exits 0 either way; only the text tells whether cupsd is up.
scheduler_up() { [[ $(lpstat -r 2>/dev/null) == "scheduler is running" ]]; }

# place TMP NAME: rename TMP into OUTPUT_DIR as NAME, or NAME-1, NAME-2... if taken.
# --update=none-fail never replaces an existing file (atomic no-replace rename), so a file
# created concurrently by another writer can't be clobbered. Prints the final path; on an
# error other than a name clash, prints the error and returns 2.
place() {
  local tmp=$1 name=$2 base ext n=0 target err retried=
  base=${name%.*}
  ext=${name##*.}
  [[ $base == "$name" ]] && ext= || ext=".$ext"
  target="$OUTPUT_DIR/$name"
  # -T: never move into a directory that happens to have the target's name.
  until err=$(mv -T --update=none-fail "$tmp" "$target" 2>&1); do
    [[ -e $tmp ]] || return 1
    # Only an existing target is a clash; anything else (permissions, a filesystem without
    # no-replace renames) would fail the same way for every suffix.
    if [[ ! -e $target && ! -L $target ]]; then
      # It may just have been consumed (deleted) since the rename failed: try the same name
      # once more before calling it an error.
      [[ -z $retried ]] && { retried=1; continue; }
      printf '%s' "$err"
      return 2
    fi
    retried=
    n=$((n + 1))
    ((n < 10000)) || return 1
    target="$OUTPUT_DIR/${base}-${n}${ext}"
  done
  printf '%s' "$target"
}

# job_title ID -> the job-name cupsd recorded for the job (empty if unknown/untitled).
# Fails if cupsd can't be asked (not up yet, or busy past the retries), so the caller can try
# again later instead of naming the file "untitled" for good.
# ipptool -l prints a header, a ruler and the value with '"' and '\' backslash-escaped.
job_title() {
  local out rc=1 attempt title
  for attempt in 1 2 3; do
    out=$(timeout 5 ipptool -l "ipp://localhost/jobs/$1" /etc/vprint/get-job-name.test 2>/dev/null)
    rc=$?
    ((rc == 124)) || break
    ((attempt < 3)) && sleep 1
  done
  if ((rc != 0)); then
    # ipptool exits 1 both for "no such job" and "can't connect"; tell them apart.
    ((rc != 124)) && scheduler_up && return 0
    return 1
  fi
  title=$(sed -n '3{s/[[:space:]]*$//; s/\\\(.\)/\1/g; p}' <<<"$out")
  [[ $title == "(stdin)" ]] && title=
  printf '%s' "$title"
}

readonly DOC_EXTENSIONS='pdf|ps|txt|text|md|rtf|csv|tsv|html?|xml|json|eml|msg|docx?|dotx?|xlsx?|pptx?|odt|ods|odp|odg|pages|numbers|key|png|jpe?g|gif|bmp|tiff?|heic|heif|webp|svg'

# sanitize TITLE -> a safe single path component: no slashes, control characters or
# leading dots; a known document extension (".txt", ".docx") is dropped; at most 100 bytes.
sanitize() {
  local s=$1
  s=${s//[[:cntrl:]]/ }
  s=${s//[\/\\:*?\"<>|]/_}
  s=$(sed -E 's/[[:space:]]+/ /g; s/^[ .]+//; s/[ .]+$//' <<<"$s")
  # Apps often send the document's file name as the title; drop known document extensions only,
  # so titles like "example.com" or "No.A12" survive.
  shopt -s nocasematch
  [[ $s =~ ^(.+)\.($DOC_EXTENSIONS)$ ]] && s=${BASH_REMATCH[1]}
  shopt -u nocasematch
  # Truncate by bytes, then drop any multi-byte character cut in half.
  s=$(printf '%s' "$s" | head -c 100 | iconv -f UTF-8 -t UTF-8 -c 2>/dev/null)
  # Dropping the extension or truncating can expose a trailing space or dot again.
  s=$(sed -E 's/[ .]+$//' <<<"$s")
  printf '%s' "${s:-untitled}"
}

# output_name STAGED_NAME -> final file name, honouring OUTPUT_LABEL.
# cups-pdf always produces "<title>-job_<id>.pdf"; the title part is unreliable, so the job's
# real title is fetched from cupsd instead.
output_name() {
  local staged=$1 id title
  if [[ $staged =~ -job_([0-9]+)\.pdf$ ]]; then
    id=${BASH_REMATCH[1]}
  else
    printf '%s' "$staged"
    return
  fi
  title=$(job_title "$id") || return 1
  title=$(sanitize "$title")
  case $OUTPUT_LABEL in
    0) printf '%s.pdf' "$title" ;;
    1) printf 'job_%s-%s.pdf' "$id" "$title" ;;
    *) printf '%s-job_%s.pdf' "$title" "$id" ;;
  esac
}

readonly CLAIM_PREFIX=.vprint-claim.

# claim SRC: move a finished cups-pdf file into a new claim directory under its output name.
claim() {
  local src=$1 name dir
  name=$(output_name "${src##*/}") || return 2
  dir=$(mktemp -d "$VPRINT_STAGING_DIR/${CLAIM_PREFIX}XXXXXXXX") || return 1
  if ! mv -T "$src" "$dir/$name"; then
    rmdir "$dir"
    return 1
  fi
  rm -f "$src.done"
}

# publish FILE: copy a claimed file into OUTPUT_DIR under its name (de-duplicated).
publish() {
  local src=$1 name=${1##*/} tmp target rc
  # Claim directories are root's own (mode 0700), so what is checked here can't change before
  # it is copied. Staging is writable by every user in the container: never follow a symlink
  # or anything else planted there, and ignore claim directories root didn't create.
  [[ -d ${src%/*} && ! -L ${src%/*} && -O ${src%/*} ]] || return 0
  if [[ ! -f $src || -L $src ]]; then
    log "ignoring a staged entry that is not a regular file: $(sanitize "$name")"
    rm -rf -- "$src" # inside root's own claim directory, so whatever it is can go
    rmdir "${src%/*}" 2>/dev/null || true
    return 0
  fi
  # A unique temporary file per publish (mktemp uses O_EXCL), so publishers sharing an output
  # directory can never overwrite each other's copy before it is renamed into place.
  if ! tmp=$(mktemp --suffix=.vprint-partial "$OUTPUT_DIR/.vprint-XXXXXXXXXX" 2>/dev/null) ||
    ! cp -- "$src" "$tmp" 2>/dev/null; then
    [[ -n ${tmp:-} ]] && rm -f "$tmp"
    blocked "$src" "cannot write to $OUTPUT_DIR (will keep retrying): $name"
    return 1
  fi
  # Owner and mode are best effort: SMB/CIFS shares and root-squashed NFS refuse them, and the
  # file is still worth delivering (it gets the share's own owner and permissions).
  if ! { chown "$PUID:$PGID" "$tmp" && chmod "$mode" "$tmp"; } 2>/dev/null && [[ -z $ownership_warned ]]; then
    log "WARNING: cannot set owner ${PUID}:${PGID} / mode ${mode} on files in $OUTPUT_DIR (e.g. a network share); they keep the filesystem's defaults"
    ownership_warned=1
  fi
  target=$(place "$tmp" "$name")
  rc=$?
  if ((rc != 0)); then
    rm -f "$tmp"
    if ((rc == 2)); then
      blocked "$src" "cannot rename into $OUTPUT_DIR (will keep retrying): $target"
    else
      blocked "$src" "could not find a free file name for $name (will keep retrying)"
    fi
    return 1
  fi
  rm -f "$src"
  rmdir "${src%/*}" 2>/dev/null || true
  log "saved ${target}"
}

# Periodic clean-up of leftovers from crashes:
# - temporary files in OUTPUT_DIR: never visible under their final name, and the source is
#   still claimed in staging, so they can go once stale;
# - incomplete PDFs in staging (/var/spool may be a volume, so they would pile up for good).
sweep() {
  local f
  find "$OUTPUT_DIR" -maxdepth 1 -name '.*.vprint-partial' -type f -mmin "+$PARTIAL_MAX_AGE_MIN" \
    -delete 2>/dev/null || true
  while IFS= read -r -d '' f; do
    [[ -e $f.done || -e $f.failed ]] && continue
    log "removing an incomplete PDF left in staging by an interrupted conversion: $(sanitize "${f##*/}")"
    rm -f "$f"
  done < <(find "$VPRINT_STAGING_DIR" -maxdepth 1 -type f -name '*.pdf' -mmin "+$ORPHAN_MAX_AGE_MIN" -print0 2>/dev/null)
  next_sweep=$((SECONDS + PARTIAL_MAX_AGE_MIN * 60))
}

# Stop between files, never in the middle of one: exiting after a file is renamed into place
# but before its staged copy is removed would publish it again on the next start.
stopping=0
trap 'stopping=1' TERM INT
stop_if_asked() { ((stopping == 0)) || exit 0; }
# Root-only directory for inspecting *.failed reports (staging is writable by every user).
find "$VPRINT_STAGING_DIR" -mindepth 1 -maxdepth 1 -type d -name '.vprint-private.*' -user root \
  -exec rm -rf {} + 2>/dev/null || true
PRIVATE=$(mktemp -d "$VPRINT_STAGING_DIR/.vprint-private.XXXXXXXX") || exit 1
: >"$HEARTBEAT"
rm -f "$STUCK"
# Titles come from cupsd, so give it a moment to come up before claiming anything.
for _ in $(seq 1 "${VPRINT_SCHEDULER_WAIT:-30}"); do
  stop_if_asked
  scheduler_up && break
  sleep 1
done
sweep
# Empty claim directories are left by a crash between publishing and clean-up.
find "$VPRINT_STAGING_DIR" -mindepth 1 -maxdepth 1 -type d -name "${CLAIM_PREFIX}*" -empty -delete 2>/dev/null || true
log "watching ${VPRINT_STAGING_DIR} -> ${OUTPUT_DIR} (owner ${PUID}:${PGID}, mode ${mode})"
while :; do
  stop_if_asked
  ((SECONDS < next_sweep)) || sweep
  for failed in "$VPRINT_STAGING_DIR"/*.failed; do
    name=${failed##*/}
    name=${name%.failed}
    id=
    [[ $name =~ -job_([0-9]+)\.pdf$ ]] && id=${BASH_REMATCH[1]}
    # Move the report somewhere only root can write before reading it: a symlink planted in
    # staging must not make root read (and log) another file.
    report=$PRIVATE/report
    rm -rf "$report"
    mv -T "$failed" "$report" 2>/dev/null || continue
    details="(unreadable report)"
    [[ -f $report && ! -L $report ]] && details=$(head -c 2000 "$report" | tr -s '[:cntrl:]' ' ')
    # Titles and Ghostscript output are untrusted: sanitize so they can't forge log lines.
    log "ERROR: PDF conversion failed for job ${id:-?} \"$(sanitize "$(job_title "${id:-0}")")\"; no file was saved: $details"
    rm -rf "$report"
    rm -f "${failed%.failed}" "${failed%.failed}.done"
  done
  for marker in "$VPRINT_STAGING_DIR"/*.done; do
    src=${marker%.done}
    if [[ -L $src ]]; then
      # cups-pdf never writes symlinks; something else planted it. Don't follow it.
      log "ignoring a staged entry that is not a regular file: $(sanitize "${src##*/}")"
      rm -f "$src" "$marker"
    elif [[ -f $src ]]; then
      claim "$src"
      case $? in
        0) ;;
        2) blocked "$src" "cupsd is not answering; ${src##*/} waits for its title (will keep retrying)" ;;
        *) blocked "$src" "cannot claim ${src##*/} in staging (will keep retrying)" ;;
      esac
    else
      rm -f "$marker"
    fi
    : >"$HEARTBEAT" # per file: a slow cupsd can make one pass take minutes
    stop_if_asked
  done
  for claimed in "$VPRINT_STAGING_DIR/$CLAIM_PREFIX"*/*; do
    publish "$claimed" || true
    : >"$HEARTBEAT"
    stop_if_asked
  done
  warned=()
  for f in "${!failing[@]}"; do warned[$f]=1; done
  failing=()
  if ((${#warned[@]})); then
    [[ -e $STUCK ]] || printf '%s\n' "$stuck_reason" >"$STUCK"
  else
    rm -f "$STUCK"
  fi
  : >"$HEARTBEAT"
  sleep "$POLL_SECONDS" &
  wait $! || true
done
